DOCKER_REGISTRY=ghcr.io/pengovbr/sei-helm

# passe vazio ou --no-cache para nao utilizar cache de build do docker
DOCKER_CACHE_ARG=


# ********************************************
# Alpine
# ********************************************

ALPINE_ORIGINAL_VERSION=3.22.3

IMAGE_ALPINE=${DOCKER_REGISTRY}/alpine
IMAGE_ALPINE_VERSION=3.22.3


# ********************************************
# php apoio make e ferramentas
# ********************************************

IMAGE_APOIO_PHP=${DOCKER_REGISTRY}/phpmaketools
IMAGE_APOIO_PHP_VERSION=0.5.0


# ********************************************
# apache e php
# ********************************************

IMAGE_APP_APACHE=${DOCKER_REGISTRY}/app-apache
IMAGE_APP_APACHE_VERSION=0.5.0

IMAGE_APP_PHP=${DOCKER_REGISTRY}/app-php
IMAGE_APP_PHP_VERSION=0.5.0

IMAGE_APP_APACHE_PHP=${DOCKER_REGISTRY}/app-apache-php
IMAGE_APP_APACHE_PHP_VERSION=0.5.0

# ********************************************
# memcached
# ********************************************

MEMCACHED_ORIGINAL_VERSION=1.6.40-alpine

IMAGE_MEMCACHED=${DOCKER_REGISTRY}/memcached
IMAGE_MEMCACHED_VERSION=0.5.0

# ********************************************
# JOD
# ********************************************

IMAGE_JOD=${DOCKER_REGISTRY}/jod
IMAGE_JOD_VERSION=0.5.0

# ********************************************
# SOLR
# ********************************************

IMAGE_SOLR=${DOCKER_REGISTRY}/solr
IMAGE_SOLR_VERSION=0.5.0

# ********************************************
# MariaDB
# ********************************************

IMAGE_MARIADB=${DOCKER_REGISTRY}/mariadb
IMAGE_MARIADB_VERSION=0.5.0

# ********************************************
# NGINX
# ********************************************

NGINX_ORIGINAL_VERSION=1.29.3

IMAGE_NGINX=${DOCKER_REGISTRY}/nginx
IMAGE_NGINX_VERSION=0.5.0



# ********************************************
# SEI e Modulos
# ********************************************

GIT_SEI_URL=github.com/pengovbr/sei
GIT_SEI_PAT=github_pat_XXXX
GIT_SEI_VERSION=release/5.1.0

GIT_MODULO_ASSINATURA_URL=github.com/pengovbr/mod-sei-assinatura-eletronica
GIT_MODULO_ASSINATURA_VERSION=release/1.3.0