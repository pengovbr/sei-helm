[global]

error_log = /proc/self/fd/2
log_limit = 1024
daemonize = no

[www]

; todo must be yes
clear_env = no

listen = 9000

access.log = /proc/self/fd/2
catch_workers_output = yes
decorate_workers_output = yes

access.format = "%R - %{HTTP_X_FORWARDED_FOR}e %t \"%m %r%Q%q\" %s %f %{milli}d %{kilo}M %C%%"

pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_spawn_rate = 32
pm.max_requests = 500
pm.process_idle_timeout = 10s