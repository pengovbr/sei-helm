# arquivo com os values para o teste, esses campos serao substituidos antes de subir um chart para teste
# note que algumas das variaveis abaixo serao traduzidas em arquivos values no formato yaml para o helm
# abaixo é apenas um exemplo de arquivo funcional, ele muda de acordo com os clusters q vc tem a sua disposicao para testar
# a instalacao helm

# abaixo seria um arquivo que aponta para 3 clusters kubernetes distintos


# define quais clusters serao usados, de acordo com o seu kube config, separe-os por espaco
kube_contexts=docker-desktop mycluster k3s


# define qual o ip determinado cluster informado acima deve responder
docker-desktop.ip-entrada=192.168.2.100
#qtde de loops aguardando o sei subir. Cada loop tenta conectar, caso de erro
# espera 10 segundos para tentar novamente
docker-desktop.loops_espera=30


# abaixo sao as vars para outra instalacao nesse mesmo cluster
# chamei-a de tests-sei* nela vamos subir um banco, um solr, um jod
# 2 memcacheds e 2 Seis distintos

docker-desktop.tests-sei-db.namespace=tests-ns-sei-db
docker-desktop.tests-sei-jod.namespace=tests-ns-sei-jod
docker-desktop.tests-sei-solr.namespace=tests-ns-sei-solr
docker-desktop.tests-sei-solr.solr.ingress=
docker-desktop.tests-sei-memcached1.namespace=tests-ns-sei-memcached1
docker-desktop.tests-sei-memcached2.namespace=tests-ns-sei-memcached2
docker-desktop.tests-sei-cacheassets.namespace=tests-ns-sei-cacheassets
docker-desktop.tests-sei-cacheassets.cacheassets.backends.0.namespace=tests-ns-sei-app1
docker-desktop.tests-sei-cacheassets.cacheassets.backends.0.host=sei1.teste
docker-desktop.tests-sei-cacheassets.cacheassets.backends.1.namespace=tests-ns-sei-app2
docker-desktop.tests-sei-cacheassets.cacheassets.backends.1.host=sei2.teste

docker-desktop.tests-sei-app1.namespace=tests-ns-sei-app1

docker-desktop.tests-sei-app1.app.servicoExterno.db=db.tests-ns-sei-db.svc.cluster.local.
docker-desktop.tests-sei-app1.app.servicoExterno.jod=jod.tests-ns-sei-jod.svc.cluster.local.
docker-desktop.tests-sei-app1.app.servicoExterno.solr=solr.tests-ns-sei-solr.svc.cluster.local.
docker-desktop.tests-sei-app1.app.servicoExterno.memcached=memcached.tests-ns-sei-memcached1.svc.cluster.local.
docker-desktop.tests-sei-app1.app.install.solr.namespace=tests-ns-sei-solr
docker-desktop.tests-sei-app1.app.host=sei1.teste


docker-desktop.tests-sei-app2.namespace=tests-ns-sei-app2

docker-desktop.tests-sei-app2.app.servicoExterno.db=db.tests-ns-sei-db.svc.cluster.local.
docker-desktop.tests-sei-app2.app.servicoExterno.jod=jod.tests-ns-sei-jod.svc.cluster.local.
docker-desktop.tests-sei-app2.app.servicoExterno.solr=solr.tests-ns-sei-solr.svc.cluster.local.
docker-desktop.tests-sei-app2.app.servicoExterno.memcached=memcached.tests-ns-sei-memcached2.svc.cluster.local.
docker-desktop.tests-sei-app2.app.install.solr.namespace=tests-ns-sei-solr
docker-desktop.tests-sei-app2.app.host=sei2.teste
docker-desktop.tests-sei-app2.app.install.idInstalacao=orgao2
docker-desktop.tests-sei-app2.app.orgao2=orgao2
docker-desktop.tests-sei-app2.app.orgao_descricao=Orgao Helm2
docker-desktop.tests-sei-app2.app.nome_complemento=Orgao Helm2




# agora vou criar as variaveis das instalacoes referentes ao meu segundo cluster: mycluster
# note q estao identicas ao cluster docker-desktop, mas adicionei storageClass diferente,
# pois nesse cluster eu nao tenho storageclass default

mycluster.ip-entrada=200.152.47.34
#qtde de loops aguardando o sei subir. Cada loop tenta conectar, caso de erro
# espera 10 segundos para tentar novamente
mycluster.loops_espera=60


mycluster.tests-sei-db.namespace=tests-ns-sei-db
mycluster.tests-sei-jod.namespace=tests-ns-sei-jod
mycluster.tests-sei-solr.namespace=tests-ns-sei-solr
mycluster.tests-sei-memcached1.namespace=tests-ns-sei-memcached1
mycluster.tests-sei-memcached2.namespace=tests-ns-sei-memcached2
mycluster.tests-sei-cacheassets.namespace=tests-ns-sei-cacheassets
mycluster.tests-sei-cacheassets.cacheassets.backends.0.namespace=tests-ns-sei-app1
mycluster.tests-sei-cacheassets.cacheassets.backends.0.host=sei1.teste
mycluster.tests-sei-cacheassets.cacheassets.backends.1.namespace=tests-ns-sei-app2
mycluster.tests-sei-cacheassets.cacheassets.backends.1.host=sei2.teste

mycluster.tests-sei-app1.namespace=tests-ns-sei-app1

mycluster.tests-sei-app1.app.servicoExterno.db=db.tests-ns-sei-db.svc.cluster.local.
mycluster.tests-sei-app1.app.servicoExterno.jod=jod.tests-ns-sei-jod.svc.cluster.local.
mycluster.tests-sei-app1.app.servicoExterno.solr=solr.tests-ns-sei-solr.svc.cluster.local.
mycluster.tests-sei-app1.app.servicoExterno.memcached=memcached.tests-ns-sei-memcached1.svc.cluster.local.
mycluster.tests-sei-app1.app.install.solr.namespace=tests-ns-sei-solr
mycluster.tests-sei-app1.app.host=sei1.teste




mycluster.tests-sei-app2.namespace=tests-ns-sei-app2

mycluster.tests-sei-app2.app.servicoExterno.db=db.tests-ns-sei-db.svc.cluster.local.
mycluster.tests-sei-app2.app.servicoExterno.jod=jod.tests-ns-sei-jod.svc.cluster.local.
mycluster.tests-sei-app2.app.servicoExterno.solr=solr.tests-ns-sei-solr.svc.cluster.local.
mycluster.tests-sei-app2.app.servicoExterno.memcached=memcached.tests-ns-sei-memcached2.svc.cluster.local.
mycluster.tests-sei-app2.app.install.solr.namespace=tests-ns-sei-solr
mycluster.tests-sei-app2.app.host=sei2.teste
mycluster.tests-sei-app2.app.install.idInstalacao=orgao2
mycluster.tests-sei-app2.app.orgao2=orgao2
mycluster.tests-sei-app2.app.orgao_descricao=Orgao Helm2
mycluster.tests-sei-app2.app.nome_complemento=Orgao Helm2


mycluster.tests-sei-db.db.storage.storageClass=nfs-client2
mycluster.tests-sei-solr.solr.storage.storageClass=nfs-client2
mycluster.tests-sei-app1.app.storage.storageClass=nfs-client2
mycluster.tests-sei-app2.app.storage.storageClass=nfs-client2


# agora vou criar as variaveis das instalacoes referentes ao meu terceiro cluster: k3s

k3s.ip-entrada=192.168.2.201
#qtde de loops aguardando o sei subir. Cada loop tenta conectar, caso de erro
# espera 10 segundos para tentar novamente
k3s.loops_espera=30


k3s.tests-sei-db.namespace=tests-ns-sei-db
